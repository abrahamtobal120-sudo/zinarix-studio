{
  "name": "zinarix-studio",
  "private": true,
  "version": "0.6.1",
  "description": "Zinarix Studio — IDE multi-IA (monorepo)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "code:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/code-oss.ps1 prepare",
    "code:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/code-oss.ps1 status",
    "code:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/code-oss.ps1 install",
    "code:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/code-oss.ps1 build",
    "code:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/code-oss.ps1 start",
    "codium:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vscodium.ps1 check",
    "codium:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vscodium.ps1 prepare",
    "codium:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vscodium.ps1 build",
    "codium:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vscodium.ps1 package",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "test:coverage": "tsc -b && vitest run --coverage",
    "lint": "eslint . && pnpm lint:css",
    "lint:css": "stylelint \"apps/desktop/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:check": "node scripts/check-catalog.mjs",
    "audit:deps": "node scripts/audit.mjs --level=high",
    "catalog:sign": "node scripts/sign-catalog.mjs sign",
    "config:sign": "node scripts/sign-app-config.mjs",
    "omni": "node apps/cli/dist/index.js",
    "desktop": "pnpm --filter @omni/desktop build && pnpm --filter @omni/desktop start",
    "desktop:install": "pnpm --filter @omni/desktop build && node apps/desktop/scripts/install-local.mjs"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "1.95.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.9",
    "stylelint": "^18.0.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
