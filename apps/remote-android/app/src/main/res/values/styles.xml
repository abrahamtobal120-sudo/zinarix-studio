<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zinarix" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
    </style>

    <style name="Zx.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/btn</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="Zx.Button.Primary">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:background">@drawable/btn_primary</item>
    </style>

    <style name="Zx.Section" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
